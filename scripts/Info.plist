<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>Sublight</string>
	<key>CFBundleIdentifier</key>
	<string>com.hypnox.sublight</string>
	<key>CFBundleName</key>
	<string>Sublight</string>
	<key>CFBundleDisplayName</key>
	<string>Sublight</string>
	<key>CFBundleExecutable</key>
	<string>Sublight</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Stamped at build time by scripts/make_app.sh from
	     Sources/SublightKit/SublightVersion.swift, which is the single source
	     of truth. The values here are only a fallback for anyone assembling a
	     bundle by hand. -->
	<key>CFBundleShortVersionString</key>
	<string>0.5.0</string>
	<key>CFBundleVersion</key>
	<string>6</string>
	<!-- Stamped at bundle time by scripts/make_app.sh from `git rev-parse HEAD`.
	     "unknown" is the fallback for a hand-assembled bundle. Never a
	     committed SHA — that would make two binaries from different commits
	     report the same identity. -->
	<key>SublightGitRevision</key>
	<string>unknown</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Apache License 2.0 — Copyright 2026 Hypnox Technologies LLC</string>
</dict>
</plist>
